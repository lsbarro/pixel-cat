---
import Base from '../layouts/Base.astro';
import { avatarSvg, catForSeed, DISC_COLORS, seedForName, spriteSvg, traitsForSeed } from '../lib/pixel-cat/index.ts';
import { catTile, howItWorks, svgDataUrl } from '../lib/page.ts';

// Everything a reader or crawler needs is drawn into the HTML: the default cat, its facts and the five steps
// from its name, and a first gallery. The script then takes over the same markup.
const steps = howItWorks(null);
const seed = BigInt(steps.seed);
const traits = traitsForSeed(seed);
const disc = steps.disc;
const cat = catForSeed(seed);
const svg = avatarSvg(cat, disc.hex, { attrs: { role: 'img', 'aria-label': traits.line } });
const decorative = { attrs: { 'aria-hidden': 'true' } };

/** Enough tiles for 5 rows of 10, the widest gallery; the script redraws it for the reader's width. */
const GALLERY_TILES = 50;
const tiles = Array.from({ length: GALLERY_TILES }, (_, i) => catTile(seedForName(`gallery ${i + 1}`)));

const twoCatsUrl = 'https://twocats.sbarro.dev/';
const title = 'pixel cat: turn any name into a pixel cat';
const description =
  'Type a name to meet its pixel cat, drawn by the same generator as two cats, the iPhone app for splitting expenses. Free PNG and SVG downloads.';
const home = Astro.site!.href;
const repo = 'https://github.com/lsbarro/pixel-cat';
// The generator is a port of the app's, so the app is what this site and its code are based on.
const twoCats = {
  '@type': 'MobileApplication',
  name: 'two cats',
  url: twoCatsUrl,
  operatingSystem: 'iOS',
  applicationCategory: 'FinanceApplication',
};
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', '@id': `${home}#website`, name: 'pixel cat', url: home },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    '@id': `${home}#app`,
    name: 'pixel cat',
    url: home,
    description,
    image: new URL('/og.png', home).href,
    applicationCategory: 'DesignApplication',
    operatingSystem: 'Any',
    browserRequirements: 'Requires JavaScript',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    author: { '@type': 'Person', name: 'Liam Sbarro' },
    isBasedOn: twoCats,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareSourceCode',
    '@id': `${home}#source`,
    name: 'pixel-cat',
    codeRepository: repo,
    license: 'https://spdx.org/licenses/MIT.html',
    programmingLanguage: 'TypeScript',
    author: { '@type': 'Person', name: 'Liam Sbarro' },
    targetProduct: { '@id': `${home}#app` },
    isBasedOn: twoCats,
  },
];
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <header class="site-header">
    <div class="band">
      <h1 class="wordmark"><img src="/favicon.svg" alt="" width="26" height="26" />pixel cat</h1>
      <nav class="site-nav" aria-label="Sections">
        <a href="#how">How it works</a>
        <a href="#cats">Cats</a>
        <a class="pill" href={twoCatsUrl}>two cats ↗</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero" aria-label="Cat generator">
      <div class="band hero-inner">
        <div class="hero-controls">
          <div>
            <label class="name-label" for="name">Type a name to meet its cat.</label>
            <input
              id="name"
              class="name-input"
              type="text"
              placeholder="pixel cat"
              autocomplete="off"
              autocapitalize="words"
              spellcheck="false"
            />
            <p class="tagline">The same name always gives the same cat.</p>
          </div>

          <div class="actions">
            <button id="random" type="button" class="button-light">Random</button>
            <fieldset class="segmented">
              <legend class="visually-hidden">Show</legend>
              <label><input type="radio" name="view" value="avatar" checked />On its disc</label>
              <label><input type="radio" name="view" value="sprite" />Sprite</label>
            </fieldset>
          </div>

          <dl class="facts">
            <div class="wide"><dt>Seed</dt><dd class="mono" id="seed">{steps.seed}</dd></div>
            <div><dt>Traits</dt><dd id="traits">{traits.line}</dd></div>
            <div>
              <dt>Disc</dt>
              <dd class="disc-value">
                <span class="swatch" id="swatch" style={`--swatch: ${disc.hex}`}></span><span id="disc">{disc.name}</span>
              </dd>
            </div>
          </dl>

          <div class="actions">
            <span class="download-label">Download</span>
            <fieldset class="segmented small">
              <legend class="visually-hidden">Size</legend>
              <label><input type="radio" name="size" value="256" />256 px</label>
              <label><input type="radio" name="size" value="512" />512 px</label>
              <label><input type="radio" name="size" value="1024" checked />1024 px</label>
            </fieldset>
            <button id="download-png" type="button" class="button-outline" aria-label="Download PNG">PNG</button>
            <button id="download-svg" type="button" class="button-outline" aria-label="Download SVG">SVG</button>
            <button id="copy" type="button" class="button-outline">Copy link</button>
            <span class="status" id="copy-status" role="status"></span>
          </div>
        </div>

        <div class="stage-wrap">
          <div class="stage" id="stage" data-view="avatar" style={`--disc: ${disc.hex}`}>
            <div class="cat" id="cat"><Fragment set:html={svg} /></div>
          </div>
        </div>
      </div>
    </section>

    <section class="how" id="how" aria-labelledby="how-title">
      <h2 class="display-heading" id="how-title">From <span id="how-subject">{steps.subject}</span> to a cat</h2>
      <ol class="steps">
        <li class="step">
          <span class="step-number">1</span>
          <h3 id="step1-title">{steps.step1Title}</h3>
          <code class="chip" id="step1-value">{steps.step1Value}</code>
          <p id="step1-body">{steps.step1Body}</p>
        </li>
        <li class="step">
          <span class="step-number">2</span>
          <h3>A 64-bit seed</h3>
          <code class="chip"><span id="step2-seed">{steps.seed}</span><br /><span class="muted" id="step2-hex">{steps.seedHex}</span></code>
          <p id="step2-body">{steps.step2Body}</p>
        </li>
        <li class="step">
          <span class="step-number">3</span>
          <h3>SplitMix64 draws</h3>
          <dl class="chip draws" id="draws">
            {steps.draws.map((draw) => <div><dt>{draw.key}</dt><dd>{draw.value}</dd></div>)}
          </dl>
          <p>Each choice is the next draw from the stream, in a fixed order.</p>
        </li>
        <li class="step">
          <span class="step-number">4</span>
          <h3>One of six discs</h3>
          <div class="chip discs" id="discs" aria-hidden="true">
            {
              DISC_COLORS.map((color, i) => (
                <span title={color.name} style={`--swatch: ${color.hex}`} data-chosen={i === steps.discIndex ? '' : undefined} />
              ))
            }
          </div>
          <p id="step4-body">{steps.step4Body}</p>
        </li>
        <li class="step step-cat">
          <span class="step-number">5</span>
          <h3>The cat</h3>
          <div class="cat-pair">
            <div class="cat" id="step-sprite"><Fragment set:html={spriteSvg(cat, decorative)} /></div>
            <span aria-hidden="true">+</span>
            <div class="cat" id="step-avatar"><Fragment set:html={avatarSvg(cat, disc.hex, decorative)} /></div>
          </div>
          <p>A white sprite with see-through pixels. Holes show the disc behind it.</p>
        </li>
      </ol>
    </section>

    <section class="two-cats" aria-labelledby="two-cats-title">
      <div class="two-cats-card">
        <img class="app-icon" src="/app-icon.png" alt="two cats app icon" width="88" height="88" />
        <div class="two-cats-copy">
          <h2 class="display-heading" id="two-cats-title">The cats from two cats</h2>
          <p>
            In <a href={twoCatsUrl}>two cats, an iPhone app for splitting expenses</a>, every person you split with
            gets a pixel cat generated from their name. This page runs the same generator, so a name gives the same
            cat here as it does in the app. Try your friends' names, then meet their cats in{' '}
            <a href={twoCatsUrl}>two cats</a>.
          </p>
        </div>
        <a class="button-light" href={twoCatsUrl}>Meet two cats</a>
      </div>
    </section>

    <section class="cats" id="cats" aria-labelledby="cats-title">
      <div class="band cats-head" id="cats-head">
        <div>
          <h2 class="display-heading" id="cats-title" tabindex="-1">More cats</h2>
          <p class="cats-sub">Random cats. Pick one to open it in the generator.</p>
        </div>
        <p class="site-links">
          The cats from <a href={twoCatsUrl}>two cats, the iPhone app for splitting expenses</a>{' · '}
          <a href={repo}>Source on GitHub</a>{' · '}
          <a href={`${repo}/blob/main/LICENSE`}>MIT licence</a>
        </p>
      </div>
      <div class="band gallery-wrap">
        <div class="tile-grid" id="gallery">
          {
            tiles.map((tile) => (
              <a class="tile" href={`?seed=${tile.seed}`} data-seed={tile.seed.toString()} title={tile.label} style={`--disc: ${tile.discHex}`}>
                <img src={tile.spriteUrl} alt={tile.label} width="64" height="64" />
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <!-- Past the gallery the page becomes an endless wall of cats. Script only, so hidden until it opens. -->
  <div class="wall" id="wall" aria-hidden="true" inert>
    <div class="wall-scroll" id="wall-scroll">
      <div id="wall-spacer"></div>
      <div class="tile-grid" id="wall-grid"></div>
      <div class="wall-end"></div>
    </div>
    <div class="wall-chrome" id="wall-chrome">
      <div class="wall-fade-top"></div>
      <div class="wall-bar">
        <button type="button" class="wall-back" id="wall-back">↑ Back to pixel cat</button>
        <span class="wall-count" id="wall-count"></span>
      </div>
      <div class="wall-fade-bottom"></div>
      <div class="dock">
        <img id="dock-img" src={svgDataUrl(avatarSvg(cat, disc.hex, { xmlns: true }))} alt="" width="52" height="52" />
        <div class="dock-text">
          <div class="dock-title" id="dock-title">Endless cats</div>
          <div class="dock-sub" id="dock-sub">Pick a cat to open it in the generator</div>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { avatarSvg, catForSeed, spriteSvg, traitsForSeed, type PixelCat } from '../lib/pixel-cat/index.ts';
    import { howItWorks, svgDataUrl } from '../lib/page.ts';
    import { avatarLayout, spriteLayout, spriteRgba } from '../lib/raster.ts';
    import { DEFAULT_NAME, fileStem, parseState, resolveState, serializeState, type CatState } from '../lib/share-state.ts';
    import { initCats } from '../scripts/cats.ts';

    type View = 'avatar' | 'sprite';

    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const nameInput = $<HTMLInputElement>('name');
    const stage = $('stage');
    const catBox = $('cat');
    const copyStatus = $('copy-status');
    const discSwatches = $('discs').children;

    let state: CatState | null = parseState(location.search);
    let view: View = 'avatar';
    let current: { cat: PixelCat; discHex: string; label: string };

    const randomSeed = (): bigint => crypto.getRandomValues(new BigUint64Array(1))[0];
    const setText = (id: string, text: string) => ($(id).textContent = text);

    function catSvg(cat: PixelCat, discHex: string, label: string, as: View, xmlns = false): string {
      const options = { xmlns, attrs: { role: 'img', 'aria-label': label } };
      return as === 'avatar' ? avatarSvg(cat, discHex, options) : spriteSvg(cat, options);
    }

    function show(): void {
      const { seed } = resolveState(state);
      const steps = howItWorks(state);
      const disc = steps.disc;
      const traits = traitsForSeed(seed);
      current = { cat: catForSeed(seed), discHex: disc.hex, label: traits.line };
      catBox.innerHTML = catSvg(current.cat, current.discHex, current.label, view);
      stage.dataset.view = view;
      stage.style.setProperty('--disc', disc.hex);
      setText('seed', steps.seed);
      setText('traits', traits.line);
      setText('disc', disc.name);
      $('swatch').style.setProperty('--swatch', disc.hex);
      nameInput.placeholder = state?.kind === 'seed' ? 'Type a name' : DEFAULT_NAME;

      setText('how-subject', steps.subject);
      setText('step1-title', steps.step1Title);
      setText('step1-value', steps.step1Value);
      setText('step1-body', steps.step1Body);
      setText('step2-seed', steps.seed);
      setText('step2-hex', steps.seedHex);
      setText('step2-body', steps.step2Body);
      $('draws').replaceChildren(
        ...steps.draws.map((draw) => {
          const row = document.createElement('div');
          row.append(
            Object.assign(document.createElement('dt'), { textContent: draw.key }),
            Object.assign(document.createElement('dd'), { textContent: draw.value }),
          );
          return row;
        }),
      );
      for (const [i, swatch] of Array.from(discSwatches).entries()) {
        swatch.toggleAttribute('data-chosen', i === steps.discIndex);
      }
      setText('step4-body', steps.step4Body);
      const decorative = { attrs: { 'aria-hidden': 'true' } };
      $('step-sprite').innerHTML = spriteSvg(current.cat, decorative);
      $('step-avatar').innerHTML = avatarSvg(current.cat, disc.hex, decorative);

      history.replaceState(history.state, '', location.pathname + serializeState(state) + location.hash);
    }

    function save(blob: Blob, filename: string): void {
      const url = URL.createObjectURL(blob);
      const link = Object.assign(document.createElement('a'), { href: url, download: filename });
      link.click();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    }

    /** The cat as a `size`-px PNG at a whole-number scale with no smoothing, so its pixels stay square. */
    async function pngBlob(cat: PixelCat, discHex: string | null, size: number): Promise<Blob> {
      const canvas = Object.assign(document.createElement('canvas'), { width: size, height: size });
      const context = canvas.getContext('2d')!;
      context.imageSmoothingEnabled = false;
      const layout = discHex === null ? spriteLayout(cat, size) : avatarLayout(cat, size);
      const pixels = new ImageData(spriteRgba(cat, layout.scale), layout.width, layout.height);
      if (discHex === null) {
        context.putImageData(pixels, layout.left, layout.top);
      } else {
        context.fillStyle = discHex;
        context.beginPath();
        context.arc(size / 2, size / 2, size / 2, 0, 2 * Math.PI);
        context.fill();
        // putImageData would replace the disc under the cat's holes; drawing at 1:1 composites over it.
        context.drawImage(await createImageBitmap(pixels), layout.left, layout.top);
      }
      return new Promise((resolve, reject) =>
        canvas.toBlob((blob) => (blob ? resolve(blob) : reject(new Error('The PNG could not be made'))), 'image/png'),
      );
    }

    nameInput.addEventListener('input', () => {
      state = parseState(serializeState({ kind: 'name', name: nameInput.value }));
      show();
    });

    $('random').addEventListener('click', () => {
      state = { kind: 'seed', seed: randomSeed() };
      nameInput.value = '';
      show();
    });

    for (const radio of document.querySelectorAll<HTMLInputElement>('input[name="view"]')) {
      radio.addEventListener('change', () => {
        view = radio.value as View;
        show();
      });
    }

    const downloadSize = () => Number(document.querySelector<HTMLInputElement>('input[name="size"]:checked')!.value);

    $('download-png').addEventListener('click', async () => {
      // Named before drawing: the cat or view can change while the PNG is made.
      const filename = `${fileStem(state)}-${view}.png`;
      save(await pngBlob(current.cat, view === 'avatar' ? current.discHex : null, downloadSize()), filename);
    });

    $('download-svg').addEventListener('click', () => {
      const svg = catSvg(current.cat, current.discHex, current.label, view, true);
      save(new Blob([svg], { type: 'image/svg+xml' }), `${fileStem(state)}-${view}.svg`);
    });

    let statusTimer: ReturnType<typeof setTimeout> | undefined;
    $('copy').addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(location.href);
        copyStatus.textContent = 'Link copied';
      } catch {
        copyStatus.textContent = 'Copy the link from the address bar';
      }
      clearTimeout(statusTimer);
      statusTimer = setTimeout(() => (copyStatus.textContent = ''), 3000);
    });

    if (state?.kind === 'name') nameInput.value = state.name;
    show();
    initCats({
      onPick(seed) {
        state = { kind: 'seed', seed };
        nameInput.value = '';
        show();
        nameInput.focus({ preventScroll: true });
      },
      currentAvatarUrl: () => svgDataUrl(avatarSvg(current.cat, current.discHex, { xmlns: true })),
    });
  </script>
</Base>
