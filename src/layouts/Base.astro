---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Structured data objects, each emitted as its own JSON-LD script. */
  jsonLd?: object[];
}

const { title, description, jsonLd = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// public/og.png, drawn by scripts/make-images.ts.
const ogImage = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="max-image-preview:large" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- The display face for the wordmark, the name and headings; OFL, see /fonts/OFL.txt. -->
    <link rel="preload" href="/fonts/jersey-10.woff2" as="font" type="font/woff2" crossorigin />
    <!-- The page opens on the green hero band. -->
    <meta name="theme-color" content="#0f3d2e" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b1310" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="pixel cat" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="pixel cat: six pixel cats on coloured discs, and pixelcat.sbarro.dev" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    <!--
      A random cat in the tab on every load. The /favicon.svg link above stays for crawlers, no-JS readers and the
      first paint; the script replaces that element rather than changing its href, which some browsers ignore.
    -->
    <script>
      import { faviconUrl } from '../lib/favicon.ts';

      const icon = document.createElement('link');
      icon.rel = 'icon';
      icon.type = 'image/svg+xml';
      icon.href = faviconUrl(crypto.getRandomValues(new BigUint64Array(1))[0]);
      document.querySelectorAll('link[rel~="icon"]').forEach((link) => link.remove());
      document.head.append(icon);
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
